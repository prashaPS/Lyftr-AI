# ── LLM Keys (comma-separated, at least 2 required) ──────────────────────────
LLM_API_KEYS=AIzaSy_YOUR_KEY_1_HERE,AIzaSy_YOUR_KEY_2_HERE

# ── SQLite database location ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ── CORS: comma-separated allowed frontend origins ────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ── Enable failover simulation via X-Simulate-Failure header ──────────────────
ENABLE_FAILURE_SIMULATION=true

# ── Frontend: backend base URL (used at Docker build time) ────────────────────
VITE_API_URL=http://localhost:8000
